#!/bin/bash
## load modules
module use -a modulefiles
module load derecho.intel

## configure, make, make install
./configure --prefix=$(pwd)/install && make -j && make install

## run test
cd test
# get fix and regression data
#commented out because the following script does not exist!
#./get_data.sh 

# submit to queue, as mpiexec cannot be used on front-end node...
# note1: you may need to adjust the "#PBS -A" directive on line 3 to reflect your charge group for the run
# note2: you may need to modify variables on line 16 in the jobcard file to reflect your environment.
qsub < jobcard.derecho.nm

# job stdout/stderr will appear in test/fcst.log
